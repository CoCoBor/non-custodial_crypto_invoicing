NODE_ENV=development
PORT=3000
NOWNODES_API_KEY=replace-with-your-nownodes-api-key
MONGODB_ROOT_USERNAME=dev_root
MONGODB_ROOT_PASSWORD=replace-with-a-random-root-password
MONGODB_DATABASE=crypto_invoicing

MONGODB_APP_USERNAME=crypto_app
MONGODB_APP_PASSWORD=replace-with-a-different-random-app-password

MONGODB_URI=mongodb://crypto_app:replace-with-app-password@127.0.0.1:27017/crypto_invoicing?authSource=crypto_invoicing

DATA_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
ACCOUNT_LOOKUP_HMAC_KEY=replace-with-a-different-base64-encoded-32-byte-keyPLATFORM_BITCOIN_ACCOUNT_KEY=replace-with-an-account-level-zprv-generated-offline
